// VisaPacks database schema
// Postgres in production (deployed as Vercel Serverless Functions with no
// persistent local disk, so SQLite isn't an option there). Point DATABASE_URL
// at any Postgres instance - Vercel Postgres/Neon, Supabase, RDS, etc.

generator client {
  provider      = "prisma-client-js"
  // Vercel's Node.js Serverless Function runtime needs this engine binary
  // in addition to whatever platform generates the client locally.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A destination country. New countries can be added at any time by
// inserting a row here (see prisma/seed.js) - the frontend and API
// discover countries dynamically, nothing is hardcoded.
model Country {
  id        String     @id @default(cuid())
  code      String     @unique // ISO-3166 alpha-2/3 code, e.g. "US", "SCHENGEN"
  slug      String     @unique // URL-friendly identifier, e.g. "united-states"
  name      String
  flagEmoji String?
  region    String?
  summary   String?
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  visaTypes VisaType[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active, sortOrder])
}

// A visa category offered for a country, e.g. "Tourist Visa", "Student Visa".
model VisaType {
  id          String    @id @default(cuid())
  countryId   String
  country     Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  packages    Package[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([countryId, slug])
  @@index([active])
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

// A purchasable self-service assistance package for a visa type.
model Package {
  id         String      @id @default(cuid())
  visaTypeId String
  visaType   VisaType    @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)
  tier       PackageTier
  name       String
  tagline    String?
  price      Float
  currency   String      @default("USD")
  turnaround String?
  features   Json // array of feature strings shown on the pricing card
  popular    Boolean     @default(false)
  active     Boolean     @default(true)
  orders     Order[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([visaTypeId, tier])
}

enum OrderStatus {
  PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// A customer's purchase of a package. No user accounts are required to buy -
// customer details are captured directly on the order (guest checkout).
model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  packageId    String
  package      Package     @relation(fields: [packageId], references: [id])
  customerName String
  email        String
  phone        String?
  travelDate   DateTime?
  notes        String?
  amount       Float
  currency     String      @default("USD")
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([email])
}
