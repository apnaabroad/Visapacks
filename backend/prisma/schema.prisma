// VisaPacks database schema
// Default datasource is SQLite for zero-setup local development.
// To move to production, switch provider to "postgresql" and set DATABASE_URL
// to a Postgres connection string - no model changes required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A destination country. New countries can be added at any time by
// inserting a row here (see prisma/seed.js) - the frontend and API
// discover countries dynamically, nothing is hardcoded.
model Country {
  id        String     @id @default(cuid())
  code      String     @unique // ISO-3166 alpha-2/3 code, e.g. "US", "SCHENGEN"
  slug      String     @unique // URL-friendly identifier, e.g. "united-states"
  name      String
  flagEmoji String?
  region    String?
  summary   String?
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  visaTypes VisaType[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active, sortOrder])
}

// A visa category offered for a country, e.g. "Tourist Visa", "Student Visa".
model VisaType {
  id          String    @id @default(cuid())
  countryId   String
  country     Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  packages    Package[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([countryId, slug])
  @@index([active])
}

// A purchasable self-service assistance package for a visa type.
// `tier` is one of: BASIC | STANDARD | PREMIUM
// (plain String because SQLite has no native enum support; validated in the API layer).
model Package {
  id          String      @id @default(cuid())
  visaTypeId  String
  visaType    VisaType    @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)
  tier        String
  name        String
  tagline     String?
  price       Float
  currency    String      @default("USD")
  turnaround  String?
  features    String // JSON-encoded array of feature strings shown on the pricing card
  popular     Boolean     @default(false)
  active      Boolean     @default(true)
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([visaTypeId, tier])
}

// `status` is one of: PENDING | PAID | IN_PROGRESS | COMPLETED | CANCELLED

// A customer's purchase of a package. No user accounts are required to buy -
// customer details are captured directly on the order (guest checkout).
model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  packageId    String
  package      Package     @relation(fields: [packageId], references: [id])
  customerName String
  email        String
  phone        String?
  travelDate   DateTime?
  notes        String?
  amount       Float
  currency     String      @default("USD")
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([email])
}
