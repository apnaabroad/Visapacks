# Postgres connection string. For local dev, point this at any reachable
# Postgres instance - e.g. the same database you provision on Vercel for
# production, or a local/Dockerized Postgres.
DATABASE_URL="postgresql://user:password@host:5432/visapacks"

PORT=4000
# Comma-separated list of allowed origins. Leave unset in production to
# allow any origin (fine for this demo API); set it once you know your
# deployed frontend's URL to lock it down. Setting either the apex domain
# or "www." subdomain automatically allows the other too - see
# src/utils/corsOrigins.js.
CORS_ORIGIN="http://localhost:5173"

# Shared secret for the admin document-upload API (/api/admin/*). Not a full
# auth system - just a header check (x-admin-secret) since there are no user
# accounts anywhere else in this app. Pick any long random string.
ADMIN_UPLOAD_SECRET="change-me"

# Optional. Where uploaded package documents (guides, checklists, letter
# templates) actually get stored. In production, connect Vercel Blob
# storage to this project (Storage -> Create Database -> Blob in the Vercel
# dashboard) and it sets this automatically - no need to set it by hand.
# Left unset locally, uploads fall back to backend/uploads/ on disk so the
# whole flow is testable without a Vercel account.
BLOB_READ_WRITE_TOKEN=""
