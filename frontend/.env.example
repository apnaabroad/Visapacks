VITE_API_URL="http://localhost:4000/api"

# Optional. Powers the destination photo on each country card and the
# country detail page banner. Get a free key at https://unsplash.com/developers
# (create an app, use its "Access Key"). Without this set, the site works
# exactly the same - it just skips the photo and shows the flag/text as
# before, no broken images.
VITE_UNSPLASH_ACCESS_KEY=""
